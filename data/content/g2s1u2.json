            {
              "when": {
                "kind": "any",
                "of": [
                  {
                    "kind": "all",
                    "of": [
                      { "kind": "equals", "path": "shapes.0.pegCount", "value": 5 },
                      { "kind": "equals", "path": "shapes.0.vertices", "value": 4 }
                    ]
                  },
                  {
                    "kind": "all",
                    "of": [
                      { "kind": "equals", "path": "shapes.0.pegCount", "value": 5 },
                      { "kind": "equals", "path": "shapes.0.vertices", "value": 3 }
                    ]
                  },
                  {
                    "kind": "all",
                    "of": [
                      { "kind": "equals", "path": "shapes.0.pegCount", "value": 6 },
                      { "kind": "equals", "path": "shapes.0.vertices", "value": 4 }
                    ]
                  },
                  {
                    "kind": "all",
                    "of": [
                      { "kind": "equals", "path": "shapes.0.pegCount", "value": 6 },
                      { "kind": "equals", "path": "shapes.0.vertices", "value": 3 }
