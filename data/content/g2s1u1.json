{
  "unit": "g2s1u1",
  "title": "세 자리 수",
  "activities": [
    {
      "id": "g2s1u1.A1",
      "title": "100 모형 융합 프레스기",
      "tasks": [
        {
          "id": "g2s1u1.A1.T1",
          "prompt": "막대 10개를 한 덩어리로 묶고, 모두 몇인지 써 보세요.",
          "engine": "E01",
          "mode": "regroup",
          "cpa": "C",
          "config": {
            "mode": "regroup",
            "start": { "tens": 10, "ones": 0 },
            "allowedBlocks": [1, 10, 100],
            "lasso": true,
            "chart": ["hundreds", "tens", "ones"]
          },
          "goal": {
            "kind": "all",
            "of": [
              { "kind": "predicate", "name": "countsAre", "args": { "hundreds": 1, "tens": 0 } },
              { "kind": "equals", "path": "response.ans.value", "value": "100" }
            ]
          },
          "hints": [
            {
              "when": { "kind": "equals", "path": "mode", "value": "regroup" },
              "level": 1,
              "say": "막대가 아직 열 개 그대로 있어요. 열 개를 한 덩어리로 묶으면 어떤 모양이 될까요?"
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "regroup" },
              "level": 2,
              "show": { "engine": "E01", "overlay": "ten-outline", "args": { "from": 10 } }
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "regroup" },
              "level": 3,
              "backtrack": "g1s2u1.hundred"
            }
          ],
          "concepts": ["g2s1u1.hundred-unit", "g2s1u1.three-digit"],
          "submit": "button",
          "response": {
            "fields": [
              {
                "kind": "number",
                "id": "ans",
                "label": "모두 몇인지",
                "forms": ["integer"]
              }
            ]
          }
        },
        {
          "id": "g2s1u1.A1.T2",
          "prompt": "판 1개, 막대 13개, 낱개 4개를 정리하고 모두 몇인지 써 보세요.",
          "engine": "E01",
          "mode": "regroup",
          "cpa": "C",
          "config": {
            "mode": "regroup",
            "start": { "hundreds": 1, "tens": 13, "ones": 4 },
            "allowedBlocks": [1, 10, 100],
            "lasso": true,
            "chart": ["hundreds", "tens", "ones"]
          },
          "goal": {
            "kind": "all",
            "of": [
              { "kind": "predicate", "name": "canonical" },
              {
                "kind": "predicate",
                "name": "countsAre",
                "args": { "hundreds": 2, "tens": 3, "ones": 4 }
              },
              { "kind": "equals", "path": "response.ans.value", "value": "234" }
            ]
          },
          "hints": [
            {
              "when": { "misconception": "MC-PV-NONCANON" },
              "level": 1,
              "say": "막대 10개로 무엇을 만들 수 있지?"
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "regroup" },
              "level": 1,
              "say": "막대가 열 개를 넘어요. 십 묶음과 낱개로 다시 정리하면 백·십·일이 각각 몇 개가 될까요?"
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "regroup" },
              "level": 2,
              "show": { "engine": "E01", "overlay": "ten-outline", "args": { "from": 10 } }
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "regroup" },
              "level": 3,
              "backtrack": "g2s1u1.hundred-unit"
            }
          ],
          "concepts": ["g2s1u1.hundred-unit", "g2s1u1.three-digit"],
          "submit": "button",
          "diagnose": [
            {
              "code": "MC-PV-NONCANON",
              "args": { "parts": ["1", "13", "4"] }
            }
          ],
          "response": {
            "fields": [
              {
                "kind": "number",
                "id": "ans",
                "label": "모두 몇인지",
                "forms": ["integer"]
              }
            ]
          }
        },
