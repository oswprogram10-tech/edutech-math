        {
          "id": "g2s1u2.A1.T4",
          "prompt": "꼭짓점이 6개인 도형이에요. 이름은 무엇일까요?",
          "engine": "E09",
          "mode": "geoboard",
          "cpa": "A",
          "config": {
            "mode": "geoboard",
            "grid": [5, 5],
            "showCounts": "never",
            "maxShapes": 1,
            "shapes": [[[1, 0], [3, 0], [4, 2], [3, 4], [1, 4], [0, 2]]]
          },
          "goal": {
            "kind": "equals",
            "path": "response.name.selected",
            "value": ["hexa"]
          },
          "hints": [
            {
              "when": { "kind": "equals", "path": "mode", "value": "geoboard" },
              "level": 1,
              "say": "삼각형, 사각형은 무엇을 보고 이름을 붙였나요?"
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "geoboard" },
              "level": 2,
              "say": "도형의 곧은 선과 꺾인 점을 세어 봐요."
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "geoboard" },
              "level": 3,
              "backtrack": "g2s1u2.side-vertex"
            }
          ],
          "concepts": ["g2s1u2.polygon-names"],
          "submit": "button",
          "response": {
            "fields": [
              {
                "kind": "choice",
                "id": "name",
                "label": "도형의 이름을 골라요.",
                "multiple": false,
                "options": [
                  { "id": "tri", "label": "삼각형" },
                  { "id": "quad", "label": "사각형" },
                  { "id": "penta", "label": "오각형" },
                  { "id": "hexa", "label": "육각형" }
                ]
              }
            ]
          }
        },
        {
          "id": "g2s1u2.A1.T5",
          "prompt": "비스듬히 놓인 도형이에요. 이 도형도 사각형일까요?",
          "engine": "E09",
          "mode": "geoboard",
          "cpa": "P",
          "config": {
            "mode": "geoboard",
            "grid": [5, 5],
            "showCounts": "never",
            "maxShapes": 1,
            "shapes": [[[1, 0], [4, 1], [3, 4], [0, 3]]]
          },
          "goal": {
            "kind": "equals",
            "path": "response.quad.selected",
            "value": ["yes"]
          },
          "hints": [
            {
              "when": { "misconception": "MC-SHAPE-ORIENTATION" },
              "level": 1,
              "say": "변과 꼭짓점을 세어 볼까요?"
            },
            {
              "when": { "misconception": "MC-SHAPE-ORIENTATION" },
              "level": 2,
              "say": "바로 세운 모습을 파란 점선으로 그렸어요. 변과 꼭짓점 수가 달라졌나요?",
              "show": { "engine": "E09", "overlay": "upright-ghost" }
            },
            {
              "when": { "misconception": "MC-SHAPE-ORIENTATION" },
              "level": 3,
              "backtrack": "g1s1u2.ignore-irrelevant"
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "geoboard" },
              "level": 1,
              "say": "곧은 선과 꺾인 점이 몇 개인지 살펴볼까요?"
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "geoboard" },
              "level": 2,
              "say": "도형의 테두리를 따라가며 변과 꼭짓점을 세어 봐요."
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "geoboard" },
              "level": 3,
              "backtrack": "g2s1u2.side-vertex"
            }
          ],
          "concepts": ["g2s1u2.polygon-names"],
          "submit": "button",
          "diagnose": [
            {
              "code": "MC-SHAPE-ORIENTATION",
              "args": { "trap": "no" },
              "path": "response.quad.selected.0"
            }
          ],
          "response": {
            "fields": [
              {
                "kind": "choice",
                "id": "quad",
                "label": "이 도형은 사각형일까요?",
                "multiple": false,
                "options": [
                  { "id": "yes", "label": "사각형이에요" },
                  { "id": "no", "label": "사각형이 아니에요" }
