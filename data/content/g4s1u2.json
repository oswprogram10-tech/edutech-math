{
  "unit": "g4s1u2",
  "title": "각도",
  "activities": [
    {
      "id": "g4s1u2.A1",
      "title": "각도기 레이저 반사 퍼즐",
      "tasks": [
        {
          "id": "g4s1u2.A1.T1",
          "prompt": "각도기를 각에 올려 세 각의 크기를 재어 보세요. 각도기를 올린 뒤 눈금을 읽어요.",
          "engine": "E09",
          "mode": "angle",
          "cpa": "C",
          "config": {
            "mode": "angle",
            "angles": [
              { "id": "a1", "degrees": 40, "base": 20 },
              { "id": "a2", "degrees": 115, "base": 0 },
              { "id": "a3", "degrees": 70, "base": 110 }
            ],
            "highlightActiveScale": true
          },
          "goal": {
            "kind": "predicate",
            "name": "readingsWithin",
            "args": { "tolerance": 1 }
          },
          "hints": [
            {
              "when": { "kind": "predicate", "name": "readWithoutAlign" },
              "level": 1,
              "say": "각도기의 0° 선이 각의 변과 겹쳐 있어?"
            },
            {
              "when": {
                "kind": "all",
                "of": [
                  { "kind": "predicate", "name": "readWithoutAlign" },
                  { "kind": "equals", "path": "protractorAligned", "value": false },
                  {
                    "kind": "any",
                    "of": [
                      { "kind": "equals", "path": "protractorOn", "value": "a1" },
                      { "kind": "equals", "path": "protractorOn", "value": "a2" },
                      { "kind": "equals", "path": "protractorOn", "value": "a3" }
                    ]
                  }
                ]
              },
              "level": 2,
              "show": { "engine": "E09", "overlay": "zero-gap" },
              "say": "각도기의 0° 선과 각의 변 사이의 틈을 빨갛게 표시했어요."
            },
            {
              "when": { "kind": "predicate", "name": "readWithoutAlign" },
              "level": 2,
              "say": "각도기의 0° 선을 각의 한 변에 맞춘 뒤 다시 읽어 보세요."
            },
            {
              "when": { "kind": "predicate", "name": "readWithoutAlign" },
              "level": 3,
              "backtrack": "g4s1u2.angle-measure"
            },
            {
              "when": { "kind": "predicate", "name": "readingFlipped" },
              "level": 1,
              "say": "한 변이 0°에 맞은 눈금은 안쪽이야, 바깥쪽이야?"
            },
            {
              "when": {
                "kind": "all",
                "of": [
                  { "kind": "predicate", "name": "readingFlipped" },
                  {
                    "kind": "any",
                    "of": [
                      { "kind": "equals", "path": "protractorOn", "value": "a1" },
                      { "kind": "equals", "path": "protractorOn", "value": "a2" },
                      { "kind": "equals", "path": "protractorOn", "value": "a3" }
                    ]
                  }
                ]
              },
              "level": 2,
              "show": { "engine": "E09", "overlay": "active-scale" },
              "say": "0°에서 시작하는 눈금만 남기고 다른 눈금은 흐리게 했어요."
            },
            {
              "when": { "kind": "predicate", "name": "readingFlipped" },
              "level": 2,
              "say": "각도기를 올린 뒤 0°에서 시작하는 눈금을 따라 읽어 보세요."
            },
            {
              "when": { "kind": "predicate", "name": "readingFlipped" },
              "level": 3,
              "backtrack": "g4s1u2.angle-measure"
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "angle" },
              "level": 1,
              "say": "각도기를 올릴 때 0° 선을 어디에 맞추어야 할까요?"
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "angle" },
              "level": 2,
              "say": "각마다 0°에서 시작하는 눈금은 어느 쪽에 있을까요?"
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "angle" },
              "level": 3,
              "backtrack": "g4s1u2.angle-measure"
            }
          ],
          "concepts": ["g4s1u2.angle-measure"],
          "submit": "button"
        },
        {
          "id": "g4s1u2.A1.T2",
