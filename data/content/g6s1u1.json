            {
              "when": { "kind": "equals", "path": "mode", "value": "partition" },
              "level": 3,
              "backtrack": "g6s1u1.whole-div-as-fraction"
            }
          ],
          "concepts": ["g6s1u1.whole-div-as-fraction"],
          "submit": "button",
          "showEngine": false,
          "response": {
            "fields": [
              {
                "kind": "choice",
                "id": "pick",
                "label": "몫이 1보다 큰 식",
                "multiple": false,
                "options": [
                  { "id": "a", "label": "2 ÷ 5" },
                  { "id": "b", "label": "5 ÷ 2" }
                ]
              }
            ]
          }
        }
      ]
    },
