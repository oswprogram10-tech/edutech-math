          "prompt": "보이는 조각을 모두 붙여 네모를 만들어요.",
          "engine": "E11",
          "mode": "tangram",
          "cpa": "C",
          "config": {
            "mode": "tangram",
            "pieceSet": "tangram",
            "silhouette": "none",
            "pieces": ["small-triangle", "small-triangle"],
            "rotationStep": 45
