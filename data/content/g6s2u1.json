{
  "unit": "g6s2u1",
  "title": "분수의 나눗셈",
  "activities": [
    {
      "id": "g6s2u1.A1",
      "title": "나누는 수 막대로 재기",
      "tasks": [
        {
          "id": "g6s2u1.A1.T1",
          "prompt": "1/8 자를 3/4 막대 위에 이어 놓아 보고, 몇 번 들어가는지 써 보세요.",
          "engine": "E05",
          "mode": "divide-measure",
          "cpa": "C",
          "config": {
            "mode": "divide-measure",
            "dividend": "3/4",
            "divisor": "1/8"
          },
          "goal": {
            "kind": "all",
            "of": [
              { "kind": "predicate", "name": "measuredIs", "args": { "value": "6" } },
              { "kind": "equals", "path": "measureComplete", "value": true },
              { "kind": "equals", "path": "response.q.value", "value": "6" }
            ]
          },
          "hints": [
            {
              "when": { "kind": "equals", "path": "mode", "value": "divide-measure" },
              "level": 1,
              "say": "자를 끝까지 이어 놓았나요? 막대 끝과 자 끝이 맞나요?"
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "divide-measure" },
              "level": 2,
              "say": "자를 되풀이해 놓은 모습을 보며 몇 번 놓였는지 세어 보세요.",
              "show": { "engine": "E05", "overlay": "ruler-repeat" }
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "divide-measure" },
              "level": 3,
              "backtrack": "g6s2u1.measure-division"
            }
          ],
          "concepts": ["g6s2u1.measure-division"],
          "submit": "button",
          "response": {
            "fields": [
              {
                "kind": "number",
                "id": "q",
                "label": "몇 번 들어가는지",
                "forms": ["integer", "fraction", "mixed"]
              }
            ]
          }
        },
