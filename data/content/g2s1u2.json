{
  "unit": "g2s1u2",
  "title": "여러 가지 도형",
  "activities": [
    {
      "id": "g2s1u2.A1",
      "title": "고무줄 기하판",
      "tasks": [
        {
          "id": "g2s1u2.A1.T1",
          "prompt": "못과 못을 곧은 선으로 이어 삼각형을 만들어요.",
          "engine": "E09",
          "mode": "geoboard",
          "cpa": "C",
          "config": {
            "mode": "geoboard",
            "grid": [5, 5],
            "showCounts": "never"
          },
          "goal": {
            "kind": "predicate",
            "name": "shapeWithVertices",
            "args": { "count": 3 }
          },
          "hints": [
            {
              "when": { "kind": "equals", "path": "mode", "value": "geoboard" },
              "level": 1,
              "say": "곧은 선 3개로 둘러싸 볼까요?"
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "geoboard" },
              "level": 2,
              "say": "닫힌 도형의 테두리를 따라가며 곧은 선을 세어 봐요."
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "geoboard" },
              "level": 3,
              "backtrack": "g1s2u3.flat-shapes"
            }
          ],
          "concepts": ["g2s1u2.side-vertex"],
          "submit": "button"
        },
        {
          "id": "g2s1u2.A1.T2",
          "prompt": "모양이 서로 다른 사각형을 두 개 만들어요.",
          "engine": "E09",
          "mode": "geoboard",
          "cpa": "C",
          "config": {
            "mode": "geoboard",
            "grid": [5, 5],
            "showCounts": "never"
          },
          "goal": {
            "kind": "predicate",
            "name": "distinctShapes",
            "args": { "vertices": 4, "count": 2 }
          },
          "hints": [
            {
              "when": { "kind": "equals", "path": "mode", "value": "geoboard" },
              "level": 1,
              "say": "두 사각형을 돌려서 겹치면 꼭 맞을까요?"
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "geoboard" },
              "level": 2,
              "say": "사각형을 바로 세우면 어떤 모양일까요? 다른 사각형과 견주어 보세요.",
              "show": { "engine": "E09", "overlay": "upright-ghost" }
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "geoboard" },
              "level": 3,
              "backtrack": "g2s1u2.side-vertex"
            }
          ],
          "concepts": ["g2s1u2.side-vertex", "g2s1u2.polygon-names"],
          "submit": "button"
        },
        {
