          "concepts": ["g4s1u2.angle-measure"],
          "submit": "button"
        },
        {
          "id": "g4s1u2.A1.T3",
          "prompt": "여섯 각을 보고 예각, 직각, 둔각 상자에 나누어 담아 보세요.",
          "engine": "E09",
          "mode": "angle",
          "cpa": "P",
          "config": {
            "mode": "angle",
            "angles": [
              { "id": "c1", "degrees": 35, "base": 10 },
