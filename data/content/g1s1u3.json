          "prompt": "두 접시를 모아요. 모두 몇 개인가요?",
          "engine": "E02",
          "mode": "part-whole",
          "cpa": "C",
          "config": {
            "mode": "part-whole",
            "groups": [3, 2],
            "parts": 2,
            "gesture": ["pinch", "drag", "divider-button"],
            "showBond": "structure",
            "icon": "apple"
          },
          "goal": {
            "kind": "all",
            "of": [
              { "kind": "predicate", "name": "platesAre", "args": { "values": [5, 0] } },
              { "kind": "equals", "path": "response.n.value", "value": "5" }
            ]
          },
          "hints": [
            {
              "when": { "misconception": "MC-COUNT-ONE-TO-ONE" },
              "level": 1,
              "say": "하나씩 손으로 짚어 볼까?"
            },
            {
              "when": { "misconception": "MC-COUNT-ONE-TO-ONE" },
              "level": 2,
              "say": "번호가 붙은 셈돌을 다시 세어 볼까?",
              "show": { "engine": "E02", "overlay": "count-ones" }
            },
            {
              "when": { "misconception": "MC-COUNT-ONE-TO-ONE" },
              "level": 3,
              "backtrack": "g1s1u1.one-to-one"
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "part-whole" },
              "level": 1,
              "say": "큰 수는 이미 알고 있지? 거기서부터 세어 볼까?"
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "part-whole" },
              "level": 2,
              "say": "접시마다 몇 개인지 나무에 그려 봤어요. 다시 세어 볼까?",
              "show": { "engine": "E02", "overlay": "bond-tree" }
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "part-whole" },
              "level": 3,
              "backtrack": "g1s1u3.compose-decompose"
            }
          ],
          "concepts": ["g1s1u3.compose-decompose"],
          "submit": "button",
          "diagnose": [
            { "code": "MC-COUNT-ONE-TO-ONE", "args": { "total": "5" }, "path": "response.n.value" }
          ],
          "response": {
            "fields": [
              { "kind": "number", "id": "n", "label": "모두 몇 개", "forms": ["integer"] }
            ]
          }
        },
