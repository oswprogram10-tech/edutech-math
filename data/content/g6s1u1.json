{
  "unit": "g6s1u1",
  "title": "분수의 나눗셈",
  "activities": [
    {
      "id": "g6s1u1.A1",
      "title": "피자를 똑같이 나누기",
      "tasks": [
        {
          "id": "g6s1u1.A1.T1",
          "prompt": "피자 3판을 4명이 똑같이 나누어 접시에 놓고, 한 명이 받는 양을 써 보세요.",
          "engine": "E05",
          "mode": "partition",
          "cpa": "C",
          "config": {
            "mode": "partition",
            "variant": "share",
            "shape": "circle",
            "wholes": 3,
            "people": 4,
            "plateLabel": false
          },
          "goal": {
            "kind": "all",
            "of": [
              { "kind": "predicate", "name": "platesAre", "args": { "value": "3/4" } },
              { "kind": "equals", "path": "allDealt", "value": true },
              { "kind": "equals", "path": "response.ans.value", "value": "3/4" }
            ]
          },
          "hints": [
            {
              "when": { "kind": "equals", "path": "mode", "value": "partition" },
              "level": 1,
              "say": "피자 한 판을 몇 조각으로 자르면 4명이 똑같이 나눌 수 있을까?"
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "partition" },
              "level": 2,
              "say": "접시마다 조각이 같은 크기로, 같은 개수만큼 놓였는지 보세요."
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "partition" },
              "level": 3,
              "backtrack": "g6s1u1.whole-div-as-fraction"
            }
          ],
          "concepts": ["g6s1u1.whole-div-as-fraction"],
          "submit": "button",
          "response": {
            "fields": [
              {
                "kind": "number",
                "id": "ans",
                "label": "한 명이 받는 양",
                "forms": ["fraction", "mixed"]
              }
            ]
          }
        },
        {
          "id": "g6s1u1.A1.T2",
          "prompt": "피자 5판을 3명이 똑같이 나누고, 한 명이 받는 양을 대분수나 가분수로 써 보세요.",
          "engine": "E05",
          "mode": "partition",
          "cpa": "C",
          "config": {
            "mode": "partition",
            "variant": "share",
            "shape": "circle",
            "wholes": 5,
            "people": 3,
            "plateLabel": false
          },
          "goal": {
            "kind": "all",
            "of": [
              { "kind": "predicate", "name": "platesAre", "args": { "value": "5/3" } },
              { "kind": "equals", "path": "allDealt", "value": true },
              { "kind": "equals", "path": "response.ans.value", "value": "5/3" }
            ]
          },
          "hints": [
            {
              "when": { "kind": "equals", "path": "mode", "value": "partition" },
              "level": 1,
              "say": "한 명이 한 판씩 받고 남은 피자는 어떻게 나눌까?"
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "partition" },
              "level": 2,
              "say": "남은 피자도 똑같이 나누어 접시마다 같은 양이 되게 해 보세요."
            },
            {
              "when": { "kind": "equals", "path": "mode", "value": "partition" },
              "level": 3,
              "backtrack": "g6s1u1.whole-div-as-fraction"
            }
          ],
          "concepts": ["g6s1u1.whole-div-as-fraction"],
          "submit": "button",
          "response": {
            "fields": [
              {
                "kind": "number",
                "id": "ans",
                "label": "한 명이 받는 양",
                "forms": ["fraction", "mixed"]
              }
            ]
          }
        },
        {
          "id": "g6s1u1.A1.T3",
          "prompt": "2 ÷ 5와 5 ÷ 2 중에서 몫이 1보다 큰 것을 골라 보세요.",
          "engine": "E05",
          "mode": "partition",
          "cpa": "A",
          "config": {
            "mode": "partition",
            "variant": "share",
            "shape": "circle",
            "wholes": 3,
            "people": 4,
            "plateLabel": false
          },
          "goal": {
            "kind": "equals",
            "path": "response.pick.selected",
            "value": ["b"]
